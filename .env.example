RAG_API_KEY=your-api-key
RAG_BASE_URL=https://api.openai.com/v1
RAG_CHAT_MODEL=gpt-4.1-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_REQUEST_TIMEOUT=30
RAG_MAX_RETRIES=2
RAG_EMBEDDING_BATCH_SIZE=20
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5

RAG_HYBRID_ENABLED=false
RAG_DENSE_WEIGHT=1.0
RAG_BM25_WEIGHT=1.0
RAG_RRF_K=60

RAG_RERANK_ENABLED=false
RAG_RETRIEVAL_CANDIDATE_K=20
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

RAG_SIMILARITY_THRESHOLD=0.30
RAG_EVIDENCE_MIN_SCORE=0.50
RAG_EVIDENCE_MIN_RESULTS=1
RAG_INDEX_DIR=storage/index
RAG_VECTOR_STORE_BACKEND=numpy
RAG_QDRANT_PATH=storage/qdrant
RAG_QDRANT_COLLECTION=rag_chunks